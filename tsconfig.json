{
  "compilerOptions": {
    "outDir": "lib/",
    "rootDir": "src/",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "sourceMap": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": false,
    // "moduleResolution": "node",
    "moduleResolution": "Bundler",
    "module": "esnext",
    "target": "es2015",
    "jsx": "react",
    "lib": ["es2019"],
    "types": ["@types/web", "vite"],
    "verbatimModuleSyntax": false
  },
  "include": ["./src/*"]
}
